{
  "config_version": 1,
  "milestone_pattern": "^M(?:[0-9]|1[01])$",
  "issue_pattern": "^#[1-9][0-9]*$",
  "risk_pattern": "^R(?:[1-9]|1[0-2])$",
  "workstreams": [
    "Protocol",
    "Platform"
  ],
  "issue_url_base": "https://github.com/example/project/issues/",
  "generator_name": "tracedoc",
  "version_transitions": {
    "require_version_increase_on_change": true,
    "require_review_date_advance_on_change": true,
    "require_major_on_schema_change": true
  },
  "requirements": {
    "required_standards": [
      "EXAMPLE-CORE",
      "RFCX",
      "LOCAL-PLAN"
    ],
    "standard_sources": [
      {
        "key": "EXAMPLE-CORE",
        "host": "standards.example.org"
      },
      {
        "key": "RFCX",
        "host": "www.rfc-editor.org"
      },
      {
        "key": "LOCAL-PLAN",
        "path": "../plan.md"
      }
    ],
    "verification_levels": [
      "unit",
      "integration",
      "adversarial",
      "documentation"
    ],
    "render": {
      "source_name": "matrix.json",
      "regenerate_command": "tracedoc render -config config.json -doc matrix.json -output matrix.md",
      "check_command": "tracedoc render -config config.json -doc matrix.json -output matrix.md -check"
    }
  },
  "threat_model": {
    "owner_pattern": "^@[a-z][a-z0-9-]*$",
    "document_statuses": [
      "draft",
      "accepted"
    ],
    "control_statuses": [
      "planned",
      "in-progress",
      "implemented"
    ],
    "evidence_levels": [
      "unit",
      "integration",
      "adversarial",
      "documentation"
    ],
    "evidence_statuses": [
      "planned",
      "deferred"
    ],
    "reference_hosts": [
      "decisions.example.org",
      "diagrams.example.org"
    ],
    "coverage": {
      "require_asset_coverage": true,
      "require_boundary_coverage": true,
      "require_flow_coverage": true,
      "require_entry_point_coverage": true,
      "require_control_coverage": true,
      "require_risk_coverage": true,
      "require_evidence_per_threat": true,
      "require_criticality_for_every_priority": true
    },
    "limits": {
      "min_criticality_examples": 2,
      "min_top_abuse_paths": 2,
      "max_top_abuse_paths": 10
    },
    "render": {
      "source_name": "threats.json",
      "regenerate_command": "tracedoc render -config config.json -doc threats.json -output threats.md",
      "check_command": "tracedoc render -config config.json -doc threats.json -output threats.md -check"
    }
  }
}
